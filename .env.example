# Copy to .env and fill in. .env is git-ignored; never commit real values.
#   cp .env.example .env

# --- Anthropic ---------------------------------------------------------------
# Create a key at https://console.anthropic.com/ and paste it into .env only.
ANTHROPIC_API_KEY=

# Model used by the agent. Any current model ID from Anthropic's docs.
SCOUT_MODEL=claude-opus-5-5
# Effort per request: low | medium | high | xhigh | max
SCOUT_EFFORT=medium
# Model that grades free-text answers in evals
SCOUT_JUDGE_MODEL=claude-opus-5-5
# Embedder for search: fastembed (local neural model) | hash (word counts)
SCOUT_EMBEDDER=fastembed

# --- Postgres: Scout's own database + migration target ------------------------
# Local-development values. Change them for anything that is not your laptop.
POSTGRES_HOST=localhost
# Host port. 5433 because a locally installed Postgres often already owns 5432.
POSTGRES_PORT=5433
POSTGRES_DB=scout
POSTGRES_USER=scout_app
POSTGRES_PASSWORD=scout_dev_pw
POSTGRES_RO_USER=scout_ro
POSTGRES_RO_PASSWORD=scout_ro_dev_pw

# --- Oracle: the source warehouse being assessed ------------------------------
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
# SYS/SYSTEM password for the container (admin; not used by Scout itself)
ORACLE_ADMIN_PASSWORD=oracle_admin_dev_pw
# Schema owner that holds the TPC-DS tables (used only by the loader)
ORACLE_USER=tpcds
ORACLE_PASSWORD=tpcds_dev_pw
# Read-only account — the only one the agent ever connects with
ORACLE_RO_USER=scout_ro
ORACLE_RO_PASSWORD=scout_ro_dev_pw
